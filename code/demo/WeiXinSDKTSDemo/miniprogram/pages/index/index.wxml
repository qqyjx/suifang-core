<view class="main-box">
  <view wx:if="{{isTestBuild}}" class="test-build-badge">测试版 {{buildTag}}</view>

  <!-- 5.06-v9: 当前患者门诊号. 没填 = 红警示 + "输入门诊号" 按钮; 已填 = 显示 + "切换" 按钮.
       客户场景: 妈妈一个微信给俩娃测, 各自输不同门诊号; 数据按门诊号写入大 JSON 每条记录. -->
  <view class="patient-bar {{patientNo ? 'patient-bar-ok' : 'patient-bar-bad'}}">
    <text wx:if="{{patientNo}}" class="patient-bar-text">当前患者 · 门诊号 {{patientNo}}</text>
    <text wx:else class="patient-bar-text">⚠ 未输入门诊号, 数据无法归属患者</text>
    <view class="patient-bar-btn" catch:tap="onPatientNoTap">{{patientNo ? '切换患者' : '输入门诊号'}}</view>
  </view>

  <!-- 5.06-v8: 连接状态条. 连上=绿; 断开=红+重连按钮.
       状态来源: data.connected (由 wx.onBLEConnectionStateChange + getConnectedBleDevice 维护) -->
  <view class="conn-bar {{connected ? 'conn-bar-ok' : 'conn-bar-bad'}}">
    <text wx:if="{{connected}}" class="conn-bar-text">● 已连接 · {{device.name || '手表'}}{{device.VPDeviceElectricPercent ? ' · 电量 ' + device.VPDeviceElectricPercent + '%' : ''}}</text>
    <text wx:else class="conn-bar-text">● 未连接, BLE 通道断开</text>
    <view wx:if="{{!connected}}" class="conn-bar-btn" catch:tap="onReconnectTap">重新连接</view>
  </view>
  <view class="top-buttom">
    <view class="buttom" catch:tap="skipDeviceGet">设备扫描</view>
    <view class="buttom buttom-active {{ connected ? 'active' : '' }}" catch:tap="closeBluetoothAdapterManager">断开连接</view>
    <!-- <view class="buttom" catch:tap="getF003">获取F003</view> -->
    <!-- <view class="buttom buttom-active" catch:tap="connectBle2">重新连接</view> -->
  </view>
  <!-- 显示设备相关信息 -->
  <view class="deviceInfo" catch:tap="blePwd">
    <view>
      <text>设备名称：{{device.name}}</text>
    </view>
    <view>
      <text>MAC地址：{{device.VPDeviceMAC}}</text>
    </view>
    <view>
      <text style="color: #010203;">固件版本：{{device.VPDeviceVersion}}</text>
    </view>
    <view>
      <text>电池电量：{{device.VPDeviceElectricPercent}}</text>
    </view>
    <view>
      <text>实时步数：{{device.step}} <text wx:if="{{device.distance}}">{{device.distance}}m </text> <text wx:if="{{device.calorie}}">{{device.calorie}}kcal</text> </text>
    </view>
  </view>

  <!-- 页面渲染 -->
  <view class="page-box">
    <view class="page-item" wx:for="{{listDate}}" wx:key="index" catch:tap="skipPages" data-path="{{item.path}}">{{item.name}}</view>
  </view>
</view>